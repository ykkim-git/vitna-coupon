# Supabase 동기화 설정 (선택 사항)
# 비워두면 localStorage만 사용합니다 = 기기 간 동기화 안 됨.
#
# Supabase 프로젝트 > Settings > API 에서 복사하세요.
# anon key는 브라우저에 노출되는 공개 키라서 커밋해도 괜찮습니다.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 한 Supabase 프로젝트로 쿠폰북을 여러 개 운영할 때 구분자 (기본값: default)
VITE_BOOK_ID=default
